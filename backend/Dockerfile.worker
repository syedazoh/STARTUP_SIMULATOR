# Six structured/rule analysis roles do not need the API's Torch/Chroma stack.
# Support uses the full backend image when model-backed retrieval is required.
FROM python:3.11-slim
WORKDIR /app
COPY requirements.worker.txt ./
RUN --mount=type=secret,id=build_ca,mode=0444 \
    if [ -r /run/secrets/build_ca ]; then export PIP_CERT=/run/secrets/build_ca REQUESTS_CA_BUNDLE=/run/secrets/build_ca SSL_CERT_FILE=/run/secrets/build_ca; fi; \
    pip install --no-cache-dir -r requirements.worker.txt
RUN useradd --uid 10001 --create-home worker
COPY --chown=10001:10001 app ./app
ENV HF_HUB_OFFLINE=1
USER 10001:10001
RUN python -m app.role_worker --help >/dev/null
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 CMD python -m app.role_worker --healthcheck
CMD ["python", "-m", "app.role_worker", "--role", "ceo"]
