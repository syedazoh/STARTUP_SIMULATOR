DEBUG=True
APP_NAME=Startup Simulator
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=startup_simulator
CHROMA_PERSIST_DIR=./chroma_data
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
