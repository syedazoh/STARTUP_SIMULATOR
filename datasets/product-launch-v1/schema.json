    },
    "goals": {
      "items": {
        "$ref": "#/$defs/Goal"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Goals",
      "type": "array"
    },
    "inventory": {
      "items": {
        "$ref": "#/$defs/Inventory"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Inventory",
      "type": "array"
    },
    "orders": {
