# Template only. Never overwrite an existing configured environment file.
BACKEND_IMAGE=REGISTRY/startup-simulator-backend:FULL_40_CHARACTER_COMMIT
WORKER_IMAGE=REGISTRY/startup-simulator-role-worker:FULL_40_CHARACTER_COMMIT
FRONTEND_IMAGE=REGISTRY/startup-simulator-next:FULL_40_CHARACTER_COMMIT
CADDY_IMAGE=REGISTRY/startup-simulator-caddy-next:FULL_40_CHARACTER_COMMIT
APP_DOMAIN=app.example.com
ACME_EMAIL=operator@example.com
ALLOWED_ORIGINS=https://app.example.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_KEY
# Existing Mongo volume must use its actual existing root credentials.
# For a fresh isolated database, generate hex passwords to avoid URI escaping errors.
MONGO_ROOT_USERNAME=REPLACE
MONGO_ROOT_PASSWORD=REPLACE
MONGO_WORKER_PASSWORD=REPLACE_WITH_DISTINCT_48_HEX_CHARACTERS
SECRET_KEY=REPLACE_WITH_DEPLOYMENT_API_SIGNING_SECRET
CREDENTIAL_MASTER_KEY=REPLACE_WITH_DEPLOYMENT_FERNET_KEY
# Independent unused signing/vault keys prevent worker access to API authority.
WORKER_SECRET_KEY=REPLACE_WITH_DISTINCT_WORKER_SIGNING_SECRET
WORKER_CREDENTIAL_MASTER_KEY=REPLACE_WITH_DISTINCT_WORKER_FERNET_KEY
MONGO_VOLUME_NAME=EXISTING_BACKED_UP_MONGO_VOLUME
CHROMA_VOLUME_NAME=EXISTING_CHROMA_VOLUME
UPLOAD_VOLUME_NAME=EXISTING_UPLOAD_VOLUME
# Optional model/provider features; never use a service-role Supabase key here.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
RAG_DENSE_ENABLED=true
RAG_RERANKER_ENABLED=true
