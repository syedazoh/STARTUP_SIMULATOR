    },
    "dataset_id": {
      "pattern": "^[a-zA-Z0-9_-]{1,80}$",
      "title": "Dataset Id",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "currency": {
      "const": "USD",
      "title": "Currency",
      "type": "string"
    },
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "company": {
