# Optional for AI features. Without a key, agents use deterministic fallbacks;
# CEO plan generation remains unavailable until a real key is configured.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: use deployment-specific values to enable credential connections.
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIAL_MASTER_KEY=<generated Fernet key>
# SECRET_KEY=<random secret>
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
