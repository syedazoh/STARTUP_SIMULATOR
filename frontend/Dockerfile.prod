FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
# Use the lockfile and install native optional dependencies for this container's
# architecture. .dockerignore prevents host node_modules from overwriting them.
RUN npm ci --include=optional
COPY . .
# Vite bakes VITE_API_URL into the bundle at build time, not at container runtime,
# so it must be supplied as a build arg (see docker-compose.prod.yml).
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
