{
  "$defs": {
    "Campaign": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "product_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Product Id",
          "type": "string"
        },
        "goal_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Goal Id",
          "type": "string"
        },
        "launch_date": {
          "format": "date",
          "title": "Launch Date",
          "type": "string"
        },
        "duration_days": {
          "maximum": 365,
          "minimum": 1,
          "title": "Duration Days",
          "type": "integer"
        },
        "budget_minor": {
          "exclusiveMinimum": 0,
          "maximum": 1000000000000,
          "title": "Budget Minor",
          "type": "integer"
        },
        "baseline_budget_minor": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Baseline Budget Minor",
          "type": "integer"
        },
        "reach_per_100_minor": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Reach Per 100 Minor",
          "type": "integer"
        },
        "conversion_bps": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Conversion Bps",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "product_id",
        "goal_id",
        "launch_date",
        "duration_days",
        "budget_minor",
        "baseline_budget_minor",
        "reach_per_100_minor",
        "conversion_bps"
      ],
      "title": "Campaign",
      "type": "object"
    },
