DEBUG=True
# Optional, local development without MongoDB only. All data resets on restart.
ALLOW_IN_MEMORY_LOGIN=False
APP_NAME=Startup Simulator
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=startup_simulator
CHROMA_PERSIST_DIR=./chroma_data
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
# Shared spacing across all AI calls in this backend process; 429 cooldowns override it.
AI_MIN_REQUEST_INTERVAL_SECONDS=2
# SECRET_KEY=<generate a deployment-specific value; omit for local defaults>
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIAL_MASTER_KEY=<generate a valid Fernet key; omit for local defaults>
# Comma-separated origins allowed to call the API (CORS). Set to the deployed
# frontend origin(s) in production; defaults cover local dev only.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Optional Next.js / Supabase authentication; keep legacy login during migration.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# One API process hosts a durable worker. MongoDB required.
BACKGROUND_JOBS_ENABLED=False
# Optional latency hint; Mongo remains the queue.
# REDIS_URL=redis://127.0.0.1:6379/0
MCP_RESOURCE_URL=http://localhost:8000/mcp/
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,testserver
RAG_DENSE_ENABLED=True
RAG_RERANKER_ENABLED=True
RAG_ALLOW_MODEL_DOWNLOAD=False
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
